# Configuración de OpenAI
OPENAI_API_KEY=tu_clave_openai_aqui

# Configuración de WordPress
WORDPRESS_URL=https://tu-sitio-wordpress.com
WORDPRESS_USERNAME=tu_usuario
WORDPRESS_PASSWORD=tu_password_aplicacion

# Configuración de Telegram Bot (OPCIONAL - para aprobación manual)
# Para obtener estos valores:
# 1. Crea un bot con @BotFather en Telegram -> obtienes TELEGRAM_BOT_TOKEN
# 2. Envía un mensaje a @userinfobot para obtener tu TELEGRAM_CHAT_ID
TELEGRAM_BOT_TOKEN=tu_token_bot_telegram
TELEGRAM_CHAT_ID=tu_chat_id_aqui

# Base de datos (SQLite por defecto)
DATABASE_URL=sqlite:///articles.db